{
  "name": "article-dispatch",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "check": "esbuild scripts/run-checks.ts --bundle --platform=node --format=esm --external:esbuild --outfile=.tmp/run-checks.mjs --log-level=warning && node .tmp/run-checks.mjs",
    "check:fixtures": "POSTS_DIR=scripts/fixtures npm run check",
    "check:bundle": "esbuild scripts/check-bundle.ts --bundle --platform=node --format=esm --outfile=.tmp/check-bundle.mjs --log-level=warning && node .tmp/check-bundle.mjs",
    "icons": "bash scripts/build-icons.sh"
  },
  "dependencies": {
    "html-to-image": "^1.11.13",
    "jszip": "^3.10.1",
    "markdown-it": "^14.1.0",
    "markdown-it-footnote": "^4.0.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@types/markdown-it": "^14.1.2",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^10.15.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.72.2",
    "vite": "^6.0.7"
  }
}
